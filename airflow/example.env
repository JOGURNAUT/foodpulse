# cp example.env .env   and fill these in.
#
# .env is gitignored. These values are read by docker-compose and handed to the
# containers as environment variables -- they are never written into a DAG, a
# profiles.yml or an Airflow connection created by hand in the UI.

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=

OPENAI_API_KEY=

# How many un-enriched reviews one DAG run sends to the model. The task is
# idempotent -- it only asks about reviews with no enrichment row yet -- so this
# caps the spend per run rather than the total. Raise it once you have watched
# a run and know what it costs.
ENRICH_SAMPLE_N=200

# Generate both of these once and keep them. Changing the Fernet key makes every
# stored connection and variable unreadable; changing the JWT secret while the
# stack is up makes workers fail to authenticate to the scheduler.
#
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
